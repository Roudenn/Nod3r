<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Nod3r.Solver\Version.props"/>
    
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Nod3r.Examples</RootNamespace>
        <PackageId>Nod3r.Examples</PackageId>
        <Title>Nod3r Examples</Title>
        <Description>Example types for Nod3r.</Description>
        <PackageTags>graph;example;voxel;nativeaot</PackageTags>
